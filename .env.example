# 数据库连接 (PostgreSQL/Supabase)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Supabase (可选，如果用自建 PostgreSQL 则不需要)
NEXT_PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxx"

# Affiliate 配置
AFFILIATE_KAKOBUY_ID="your_kakobuy_affiliate_id"
AFFILIATE_CNFANS_ID="your_cnfans_affiliate_id"
AFFILIATE_ACBUY_ID="your_acbuy_affiliate_id"

# 网站配置
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"
NEXT_PUBLIC_SITE_NAME="FindsIndex"

# 可选：Sentry 错误监控
SENTRY_DSN=""
